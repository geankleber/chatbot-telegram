# Copie este arquivo para ".env" e preencha com seus próprios valores.
# Nunca commite o arquivo ".env" com valores reais.

# Domínio público onde o N8N será acessado (com HTTPS via Traefik)
N8N_HOST=seu-dominio.com

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Chave de criptografia do N8N (gere uma string aleatória segura)
N8N_ENCRYPTION_KEY=
